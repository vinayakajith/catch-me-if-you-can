# Copy to .env in the project root. Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
FATHER_HUNTER_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
FATHER_HUNTER_IMAGE_QUALITY=high
FATHER_HUNTER_API_PORT=8787
# Optional: override automatic same-Wi-Fi invite address detection.
# FATHER_HUNTER_SHARE_ORIGIN=http://192.168.1.10:5173
# Private local storage, ignored by Git. Relative to the project root.
FATHER_HUNTER_DATA_DIR=.father-hunter
# Local development guard, counts creation requests before calling OpenAI.
FATHER_HUNTER_DAILY_JOBS=20
# A $1 total development spend cap is enforced in the server.
# Its ledger lives in .father-hunter/development-spend.sqlite. Do not delete it
# while using the development key: expiry/restart must never reset spending.
