{
  "name": "father-hunter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/web", "packages/game-core"],
  "scripts": {
    "dev": "npm run dev --workspace @father-hunter/web",
    "build": "npm run typecheck && npm run build --workspace @father-hunter/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "preview": "npm run preview --workspace @father-hunter/web"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.60.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
