{
  "name": "father-hunter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/game-core"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @father-hunter/web",
    "dev:server": "node --env-file-if-exists=.env --watch apps/server/src/main.ts",
    "build": "npm run typecheck && npm run build --workspace @father-hunter/web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/server/tsconfig.json",
    "test": "node --test packages/game-core/test/*.test.ts apps/server/test/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:characters": "node scripts/character-browser-check.mjs",
    "preview": "npm run preview --workspace @father-hunter/web"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.60.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
