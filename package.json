{
  "name": "catch-me-if-you-can",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/game-core"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @catch-me-if-you-can/web",
    "dev:server": "node --env-file-if-exists=.env --watch apps/server/src/main.ts",
    "build": "npm run typecheck && npm run build --workspace @catch-me-if-you-can/web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/server/tsconfig.json",
    "test": "node --test packages/game-core/test/*.test.ts apps/server/test/*.test.ts apps/web/test/*.test.ts",
    "test:aws": "node scripts/aws-test.mjs",
    "test:load:aws": "node scripts/aws-test.mjs --load",
    "test:shared": "node scripts/shared-browser-check.mjs",
    "test:load:shared": "node scripts/aws-test.mjs --shared-load",
    "build:aws": "npm run build && node scripts/build-aws.mjs",
    "test:infra": "tsc --noEmit -p infra/tsconfig.json && node --test infra/test/*.test.ts",
    "infra:synth": "cdk synth --quiet",
    "security:check": "node scripts/security-check.mjs",
    "test:lambda": "node scripts/lambda-check.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:characters": "node scripts/character-browser-check.mjs",
    "generation:cost": "node scripts/generation-cost.mjs",
    "preview": "npm run preview --workspace @catch-me-if-you-can/web",
    "test:multiplayer": "node scripts/multiplayer-browser-check.mjs",
    "test:load": "node scripts/multiplayer-load-check.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "playwright": "1.60.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
